rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // News Entity Validation
    function isValidNews(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.slug is string && data.slug.size() <= 200 &&
             data.category is string &&
             data.author is string &&
             data.contentBody is string &&
             data.featuredImage is string &&
             data.gallery is list && data.gallery.size() <= 8;
    }

    // Match News
    match /news/{newsId} {
      allow read: if true; // Public read
      allow create: if isAdmin() && isValidId(newsId) && isValidNews(request.resource.data);
      allow update: if isAdmin() && isValidNews(request.resource.data);
      allow delete: if isAdmin();
    }

    // Match Admins
    match /admins/{adminId} {
      allow read, write: if isAdmin();
      // Allow initial setup if collection is empty (optional but risky)
      // For this project, we'll assume admin user is added via console or a specific setup turn
    }
  }
}
